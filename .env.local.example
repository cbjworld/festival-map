# 한국관광공사 TourAPI 4.0 서비스 키 (Decoding 키 사용 권장)
# https://www.data.go.kr 에서 "한국관광공사_국문 관광정보 서비스_GW" 활용신청 후 발급
TOUR_API_KEY=

# 카카오맵 JavaScript API 앱 키 (카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키)
# https://developers.kakao.com
# 클라이언트(브라우저)에서 사용되므로 NEXT_PUBLIC_ 접두사가 필요합니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# (선택) 카카오톡 공유하기용 JavaScript 키 - 보통 위 지도 키와 동일한 앱의 JS 키를 사용합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
